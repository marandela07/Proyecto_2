// FUNCIÓN: initPWM 
void initPWM(){
  ledcSetup(pwmChannel1, freqPWM, resPWM);
  ledcAttachPin(ledR, pwmChannel1);
  ledcWrite(pwmChannel1, 0);

  ledcSetup(pwmChannel2, freqPWM, resPWM);
  ledcAttachPin(ledG, pwmChannel2);
  ledcWrite(pwmChannel2, 0);

  ledcSetup(pwmChannel3, freqPWM, resPWM);
  ledcAttachPin(ledA, pwmChannel3);
  ledcWrite(pwmChannel3, 0);
}

// FUNCIÓN: initSPI_Correct 
void initSPI_Correct(){
  spi_bus_config_t buscfg;
  memset(&buscfg, 0, sizeof(buscfg));
  buscfg.mosi_io_num = SPI_MOSI;
  buscfg.miso_io_num = SPI_MISO;
  buscfg.sclk_io_num = SPI_SCK;
  buscfg.quadwp_io_num = -1;
  buscfg.quadhd_io_num = -1;

  spi_slave_interface_config_t slvcfg;
  memset(&slvcfg, 0, sizeof(slvcfg));
  slvcfg.mode = 0;
  slvcfg.spics_io_num = SPI_SS;
  slvcfg.queue_size = 3;
  slvcfg.flags = 0;

  spi_slave_initialize(VSPI_HOST, &buscfg, &slvcfg, 2);
  memset(spi_slave_tx_buf, 0xAA, BUFFER_SIZE);
}

// FUNCIÓN: procesaComandoSPI
void procesarComandoSPI(){
  if (spiCmd) {
    Serial.println("\n[SPI] .:・°☆.。.:・°☆.。.:・°☆.。.:・°☆* ");
    Serial.print("[SPI] LED: ");
    Serial.print(spiLed);
    Serial.print(", Tiempo: ");
    Serial.println(spiTiempo);
    Serial.println("[SPI] .:・°☆.。.:・°☆.。.:・°☆.。.:・°☆*\n");
    
    modoSPI = true;
    ejecutarComandoLed(spiLed, spiTiempo);
    spiCmd = false;
  }
}

// FUNCIÓN: onReceive
void onReceive(int numBytes) {
  while (Wire.available()) {
    uint8_t incomingByte = Wire.read();
    Serial.write(incomingByte);
  }
}

// FUNCIÓN: onRequest 
void onRequest() {
  int pot = analogRead(pot1);
  float voltaje = (pot * 3.3) / 4095.0; // conversión a voltaje

  // Convertir float a bytes
  uint8_t voltajeBytes[4];
  memcpy(voltajeBytes, &voltaje, sizeof(float));

  // Enviar al STM32 (4 bytes)
  Wire.write(voltajeBytes, 4);
}


//FUNCIÓN: initLCD 
void initLCD() {
  //Configurar todos los pines LCD como OUTPUT primero
  pinMode(rs, OUTPUT);
  pinMode(en, OUTPUT); 
  pinMode(d4, OUTPUT);
  pinMode(d5, OUTPUT);
  pinMode(d6, OUTPUT);
  pinMode(d7, OUTPUT);
  
  //Inicializar LCD
  lcd.begin(16, 2);
  delay(50);
  lcd.clear();
  lcd.print("Iniciando...");
}

void ejecutarComandoLed(int led, int tiempo){
  // Apagar todos los LEDs antes de encender uno nuevo
  digitalWrite(ledR, LOW);
  digitalWrite(ledG, LOW);
  digitalWrite(ledA, LOW);
  delay(50);

  switch (led){
    case 1:
      ultimoLED = "R";
      Serial.println("[LED] Rojo Encendido");
      digitalWrite(ledR, HIGH);
      break;
    case 2:
      ultimoLED = "A";
      Serial.println("[LED] Amarillo Encendido");
      digitalWrite(ledG, HIGH);
      break;
    case 3:
      ultimoLED = "G";
      Serial.println("[LED] Verde Encendido");
      digitalWrite(ledA, HIGH);
      break;
    default:
      return;
  }

  Serial.print("[LED] Duracion: ");
  Serial.print(tiempo);
  Serial.println(" ms");
  delay(tiempo);

  // Apagar LEDs
  digitalWrite(ledR, LOW);
  digitalWrite(ledG, LOW);
  digitalWrite(ledA, LOW);
  Serial.println("[LED] LED apagado\n");

  // 🔹 Actualizar LCD inmediatamente después de encender un LED
  float potVolt = (analogRead(pot1) * 3.3) / 4095.0;
  int potBits = analogRead(pot1);
  float voltaje;
  int valorBits;

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("V:");
  lcd.print(potVolt);
  lcd.print(" B:");
  lcd.print(potBits);

  lcd.setCursor(0, 1);
  lcd.print("Led:");
  lcd.print(ultimoLED);
}


